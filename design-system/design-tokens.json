      "bodyGlobal": { "value": "#f4f5f7", "usage": "خلفية <body> خارج نطاق .admin-ui — الأزرق الرمادي الأقدم" },
      "surface": { "value": "#ffffff", "usage": "بطاقة · نافذة · قائمة منسدلة · شريط جانبي · ترويسة" },
      "surfaceMuted": { "value": "#fafafa", "usage": "تحويم صفّ الجدول · تحويم الزرّ المحدَّد · قدم البطاقة · الحقل المعطَّل" },
      "surfaceSubtle": { "value": "#f2f2f0", "usage": "الشريحة · الشارة المحايدة · تحويم القائمة · الصورة الرمزية · الرابط الجانبي النشط", "aliases": ["--secondary", "--muted", "--accent"] },
      "surfaceSubtleHover": { "value": "#e9e9e6", "usage": "تحويم زرّ subtle" },
      "surfaceWarm": { "value": "#f7f7f5", "usage": "تحويم .ui-btn-secondary" },
      "tableHead": { "value": "#fbfbfa", "usage": "خلفية رأس .ui-table (CSS القديم)" }
