{
  "$meta": {
    "name": "EventPlus Design System",
    "source": "eventplus.Saas — Laravel 12 + Inertia + React 19 + Tailwind CSS v4",
    "extractedFrom": [
      "resources/css/app.css",
      "resources/js/Components/**",
      "resources/js/Layouts/**",
      "resources/js/Pages/**"
    ],
    "note": "كل قيمة هنا منقولة حرفيًّا من الشيفرة. الظلال لها حقل tailwind بصيغة الشُرَط السفليّة كما تُكتب في الأصناف. حيث اختلفت الشاشات وُثّق الاختلاف وحُدّد الأكثر استعمالًا — ولم تُخترع قيمة وسطى.",
    "direction": "RTL افتراضًا (html:not([dir]) { direction: rtl }) مع دعم LTR كامل عبر الخصائص المنطقية"
  },

  "color": {
    "core": {
      "ink": {
        "value": "#111111",
        "usage": "لون النصّ الأساسي واللكنة (accent) وخلفية الزرّ الأساسي. الأكثر استعمالًا في النظام كلّه (371 موضعًا بصيغة #111).",
        "aliases": ["--ui-text", "--ui-accent", "--foreground", "--primary", "--card-foreground", "--popover-foreground"]
      },
      "black": { "value": "#000", "usage": "حالة :active للزرّ الأساسي وحدها — مكتوبة #000 في الشيفرة لا #000000" },
      "white": { "value": "#ffffff", "usage": "أسطح البطاقات والنوافذ والشريط الجانبي", "aliases": ["--ui-surface", "--card", "--popover", "--primary-foreground"] }
