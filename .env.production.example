# =====================================================================
#  افنت بلس — قالب إعدادات الإنتاج
#
#  انسخه إلى .env على الخادم ثم املأ القيم:  cp .env.production.example .env
#  بعد التعبئة تحقّق دائمًا بـ:              php artisan eventplus:preflight
#
#  ما يلي ليس تفضيلات تجميلية: كل سطر مُعلَّم بـ(حرج) يفتح ثغرة إن أُهمل.
# =====================================================================

APP_NAME="EventPlus"
# (حرج) local يُسجّل مسار الدخول التجريبي الذي يمنح جلسة مدير منصة بلا كلمة مرور
APP_ENV=production
# (حرج) توليده مرّة واحدة: php artisan key:generate
APP_KEY=
# (حرج) مفتوحًا يعرض أي خطأ مسارات الملفات ومحتوى .env للزائر
APP_DEBUG=false
# (حرج) تُبنى منه روابط الفواتير والبريد وإعادة التوجيه
APP_URL=https://your-domain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_TIMEZONE=Asia/Muscat

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --------------------------- قاعدة البيانات ---------------------------
# SQLite تكفي متجرًا واحدًا. لعدّة متاجر ومستخدمين متزامنين استخدم MySQL.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=eventplus
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

# ------------------------------ الجلسات ------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
# (حرج) بدونه تنتقل كوكي الجلسة على http فتُلتقط على الشبكات المفتوحة
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------------------- البريد -------------------------------
# بدون إعداد صحيح تفشل التنبيهات والتقارير الشهرية بصمت — بلا رسالة خطأ
# البريدُ عبر Postmark (HTTPS) — منافذُ SMTP الصادرة محجوبةٌ على الخادم
MAIL_MAILER=postmark
POSTMARK_API_KEY=
# سرُّ webhook: https://postmark:<SECRET>@<domain>/webhooks/postmark
POSTMARK_WEBHOOK_SECRET=
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------- بذرة أول تشغيل ----------------------------
# تُقرأ مرّة واحدة عند php artisan migrate --seed لإنشاء أول حسابين.
# (حرج) غيّرها قبل التشغيل — القيم الافتراضية معروفة للجميع،
# وفحص preflight يرفض الإطلاق إن بقيت.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_OWNER_NAME=
SEED_BUSINESS_NAME=

# واتساب — يبقى فارغًا حتى قرار التفعيل (docs/COMMUNICATIONS_GO_LIVE.md)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

VITE_APP_NAME="${APP_NAME}"
