APP_NAME="Event Plus OSS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily لا single: ملفٌّ واحدٌ لا يُدوَّر يبتلع القرص بلا سقف — بلغ على
# الإنتاج ٢١٣ ميغابايت، ٤٩٬٨٦٤ سطرًا منها لعطبٍ واحد تكرّر ثلاثة أيام.
# وقراءةُ ملفٍّ بهذا الحجم تعني أنّ أحدًا لا يقرؤه.
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# البريد — بلا هذا لا استعادةَ لحساب.
#
# محلّيًّا `log` (يُكتب في storage/logs ولا يُرسل). وعلى الإنتاج postmark عبر
# HTTPS (منافذُ SMTP الصادرة محجوبةٌ على خادم DigitalOcean) — انظر
# .env.production.example. وResend نُزع من المشروع فلا يُكتب هنا.
#
# POSTMARK_API_KEY سرٌّ: يُكتب في ملفّ الخادم وحده ولا يُرفع هنا أبدًا.
MAIL_MAILER=log
POSTMARK_API_KEY=
POSTMARK_WEBHOOK_SECRET=
MAIL_FROM_ADDRESS=no-reply@eventplusapp.om
MAIL_FROM_NAME="افنت بلس"

# إعدادات SMTP باقيةٌ لمن يشغّل المشروع على خادمٍ لا يحجب المنفذ:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME هو ما يقرؤه لارافيل في هذه النسخة، و MAIL_ENCRYPTION مفتاحٌ ميت
# لا يقرؤه شيء — والمنفذ 587 يتفاوض على STARTTLS من نفسه.
# MAIL_SCHEME=smtp

# المراسلات — المرحلة 6
# Postmark: المفتاح للإرسال، والسرُّ لبوّابة الأخبار (يُوضع في عنوان الـwebhook
# عند Postmark هكذا: https://postmark:SECRET@hadath.om/webhooks/postmark)
# MAIL_MAILER=postmark
# POSTMARK_API_KEY=
# POSTMARK_WEBHOOK_SECRET=
# واتساب (WhatsApp Cloud API من Meta): لا يُعرض بابُ واتساب حتى يُضبط الرمزُ ومعرّفُ الرقم.
# app_secret يوقّع Meta به الأخبار، وverify_token ما نختاره ويُعاد لنا عند تسجيل الـwebhook
# (GET/POST https://hadath.om/webhooks/whatsapp)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# شركةُ الرقم لصندوق الوارد — تُترك فارغةً حين لا شركةَ على الخادم غيرُها
# WHATSAPP_BUSINESS_ID=

# استعادة الحساب — أرقامٌ تُضبط ولا تُكتب في الكود
PASSWORD_RECOVERY_OTP_TTL=600
PASSWORD_RECOVERY_OTP_MAX_ATTEMPTS=5
PASSWORD_RECOVERY_RESEND_COOLDOWN=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# بيانات الحساب الأول التي تنشئها البذرة النظيفة (php artisan migrate --seed)
# غيّرها قبل أي نشر حقيقي
SEED_ADMIN_EMAIL=admin@eventplus.local
SEED_ADMIN_PASSWORD=password
SEED_OWNER_NAME="مالك الشركة"
SEED_BUSINESS_NAME="Event Plus"

